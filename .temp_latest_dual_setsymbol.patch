+def apply_dual_legendary_accents(data,left_code,right_code):
+    """
+    Dual-color legendary nonlands keep their normal body treatment, but their
+    legendary accent pieces use the exact same eased left/right blend approved
+    for dual lands. This applies to the crown plus the masked Pinline and Rules
+    layers (the latter is the visible rules-box outline in these templates).
+    """
+    if left_code not in STANDARD_COLOR_ORDER or right_code not in STANDARD_COLOR_ORDER:
+        raise BuildError("dual legendary accent colors must be W/U/B/R/G")
+    gradient_src=dual_gradient_fill_src(left_code,right_code)
+    crown_done=False
+    pinline_done=False
+    rules_done=False
+    pair_name=f"{COLOR_NAMES[left_code]}/{COLOR_NAMES[right_code]}"
+    for frame in data.get("frames",[]):
+        if not isinstance(frame,dict):
+            continue
+        masks=frame.get("masks",[]) if isinstance(frame.get("masks",[]),list) else []
+        mask_names={str(m.get("name","")) for m in masks if isinstance(m,dict)}
+        src=str(frame.get("src",""))
+        name_lower=str(frame.get("name","")).lower()
+
+        if ("crown" in name_lower or "/crowns/" in src) and not crown_done:
+            frame["src"]=gradient_src
+            frame["masks"]=[{"src":src,"name":"Crown"}]
+            frame["name"]=f"{pair_name} Legend Crown"
+            crown_done=True
+            continue
+
+        if "Pinline" in mask_names:
+            frame["src"]=gradient_src
+            frame["name"]=f"{pair_name} Pinline"
+            pinline_done=True
+            continue
+
+        if "Rules" in mask_names:
+            frame["src"]=gradient_src
+            frame["name"]=f"{pair_name} Rules"
+            rules_done=True
+            continue
+
+    if not crown_done:
+        raise BuildError("dual legendary accents expected a crown layer but none was found")
+    if not pinline_done:
+        raise BuildError("dual legendary accents expected a pinline layer but none was found")
+    if not rules_done:
+        raise BuildError("dual legendary accents expected a rules layer but none was found")
+
