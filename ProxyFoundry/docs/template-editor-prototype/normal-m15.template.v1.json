  "colorPolicy": {
    "variants": {
      "W": "White",
      "U": "Blue",
      "B": "Black",
      "R": "Red",
      "G": "Green",
      "M": "Multicolor",
      "A": "Artifact",
      "L": "Land",
      "C": "Colorless"
    },
    "inputColors": "card.frameColors",
    "colorOrder": [
      "W",
      "U",
      "B",
      "R",
      "G"
    ],
    "bodyColor": {
      "mode": "firstMatch",
      "cases": [
        {
          "when": {
            "field": "card.isLand",
            "equals": true
          },
          "value": "L"
        },
        {
          "when": {
            "field": "card.colorCount",
            "equals": 0
          },
          "valueFrom": {
            "if": {
              "field": "card.isArtifact",
              "equals": true
            },
            "then": "A",
            "else": "C"
          }
        },
        {
          "when": {
            "field": "card.colorCount",
            "equals": 1
          },
          "valueFrom": "card.frameColors[0]"
        }
      ],
      "otherwise": "M"
    },
    "ptColor": {
      "from": "bodyColor",
      "remap": {
        "L": "C"
      }
    },
    "accentColor": {
      "from": "bodyColor"
    },
    "palette": {
      "W": "#f6f5ee",
      "U": "#286fa8",
      "B": "#26212a",
      "R": "#e43c24",
      "G": "#0f8146"
    },
    "pinlineColors": {
      "single": "nativeImage",
      "two": {
        "kind": "gradient",
        "colorsFrom": "card.frameColors",
        "direction": "left-to-right",
        "transition": {
          "start": 0.4,
          "end": 0.6,
          "curve": "smoothstep"
        },
        "mask": "Masks.Pinline"
      },
      "threeOrMore": "nativeMulticolorImage"
    },
    "crownColors": {
      "single": "nativeImage",
      "two": {
        "kind": "imageBlend",
        "images": "CrownImages",
        "colorsFrom": "card.frameColors",
        "maskSpace": "canvas",
        "direction": "left-to-right",
        "transition": {
          "start": 0.4,
          "end": 0.6,
          "curve": "smoothstep"
        }
      },
      "threeOrMore": "nativeMulticolorImage"
    }
  },
