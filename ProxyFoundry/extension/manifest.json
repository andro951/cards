{
  "manifest_version": 3,
  "name": "Bulk Proxy Forge Print Helper",
  "version": "1.3.0",
  "description": "Import public Archidekt and MTGGoldfish decks on this computer and send paired print orders to TCGPlaytest. Never checks out or pays.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*.pages.dev/*", "https://andro951.github.io/*", "https://archidekt.com/*", "https://www.mtggoldfish.com/*", "https://www.tcgplaytest.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Bulk Proxy Forge helper — deck imports and Print Cards"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1/*", "http://localhost/*", "https://*.pages.dev/*", "https://andro951.github.io/*"], "js": ["site-bridge.js"], "run_at": "document_idle"},
    {"matches": ["https://www.tcgplaytest.com/*"], "js": ["bridge.js"], "run_at": "document_idle"}
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}
}
