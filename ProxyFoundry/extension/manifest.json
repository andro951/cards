{
  "manifest_version": 3,
  "name": "Proxy Foundry Print Helper",
  "version": "1.0.0",
  "description": "Send an explicitly paired Proxy Foundry order to TCGPlaytest in a new tab. Never checks out or pays.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://www.tcgplaytest.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Proxy Foundry Print Helper — use Open in TCGPlaytest in your workspace"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1/*", "http://localhost/*"], "js": ["site-bridge.js"], "run_at": "document_idle"},
    {"matches": ["https://www.tcgplaytest.com/*"], "js": ["bridge.js"], "run_at": "document_idle"}
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}
}
