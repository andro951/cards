+def svg_size(raw):
+    """Best-effort intrinsic SVG dimensions for set-symbol placement."""
+    try:
+        text=raw.decode("utf-8",errors="ignore")[:16384]
+    except Exception:
+        return None
+    m=re.search(r'<svg\b[^>]*\bwidth=["\']\s*([0-9.]+)(?:px)?["\'][^>]*\bheight=["\']\s*([0-9.]+)(?:px)?["\']',text,re.I)
+    if m:
+        try:
+            return float(m.group(1)),float(m.group(2))
+        except ValueError:
+            pass
+    m=re.search(r'\bviewBox=["\']\s*[-+0-9.eE]+[ ,]+[-+0-9.eE]+[ ,]+([-+0-9.eE]+)[ ,]+([-+0-9.eE]+)\s*["\']',text,re.I)
+    if m:
+        try:
+            return float(m.group(1)),float(m.group(2))
+        except ValueError:
+            pass
+    return None
+
+
+def image_size_from_source(src):
+    raw=load_bytes(src)
+    return png_size(raw) or gif_size(raw) or jpeg_size(raw) or svg_size(raw)
