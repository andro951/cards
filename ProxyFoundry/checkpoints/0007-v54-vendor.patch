+def apply_universal_set_symbol_geometry(data,symbol_source):
+    """Apply set-symbol alignment and type-line collision rules.
+
+    Ordinary templates use the universal right edge ``SET_SYMBOL_RIGHT_EDGE``.
+    When they have a primary unrotated ``type`` text box, the symbol is also
+    vertically centered on that box using its *actual rendered height*.
+
+    Kamigawa Flip cards are a deliberate exception because the upright face's
+    P/T medallion occupies the normal set-symbol position.  For Flip cards:
+
+      * the set symbol is vertically centered on the upright ``type`` box;
+      * if the upright face has P/T, the symbol's right edge is placed one
+        ``SET_SYMBOL_TYPE_GAP`` to the left of the upright P/T text/medallion
+        anchor;
+      * the upright type text ends one gap before the symbol;
+      * the rotated lower type text reserves space for its own P/T medallion.
+
+    This keeps the generated geometry relational even though Card Conjurer
+    ultimately stores all positions in global card coordinates.
+    """
+    size=image_size_from_source(symbol_source)
+    if not size:
+        raise BuildError("could not determine set-symbol image dimensions for placement")
+    iw,ih=size
+    cw=float(data.get("width",CARD_WIDTH) or CARD_WIDTH)
+    ch=float(data.get("height",CARD_HEIGHT) or CARD_HEIGHT)
+    zoom=float(data.get("setSymbolZoom",1.0) or 1.0)
+    symbol_w=(float(iw)*zoom)/cw
+    symbol_h=(float(ih)*zoom)/ch
+
+    text=data.get("text",{})
+    version=str(data.get("version","") or "").lower()
+    bounds=data.get("setSymbolBounds")
+
+    # Kamigawa Flip layout: the top P/T medallion occupies the normal symbol
+    # slot, so anchor the symbol immediately to its left and reserve the type
+    # text around both elements.  The lower rotated type line independently
+    # reserves room for its lower P/T medallion.
+    if version == "flip" and isinstance(text,dict):
+        primary_type=text.get("type")
+        top_pt=text.get("pt")
+        bottom_type=text.get("type2")
+        bottom_pt=text.get("pt2")
+
+        if not isinstance(primary_type,dict):
+            raise BuildError("Flip layout is missing primary type geometry")
+        try:
+            ty=float(primary_type.get("y"))
+            th=float(primary_type.get("height"))
+            tx=float(primary_type.get("x"))
+        except (TypeError,ValueError):
+            raise BuildError("Flip layout has invalid primary type geometry")
+
+        # With an upright P/T box, use its left text/medallion anchor as the
+        # protected edge.  Without one, fall back to the universal right edge.
+        if isinstance(top_pt,dict):
+            try:
+                pt_left=float(top_pt.get("x"))
+            except (TypeError,ValueError):
+                raise BuildError("Flip layout has invalid upright P/T geometry")
+            symbol_right=pt_left-SET_SYMBOL_TYPE_GAP
+        else:
+            symbol_right=SET_SYMBOL_RIGHT_EDGE
+
+        left=symbol_right-symbol_w
+        if left<=tx:
+            raise BuildError("Flip set symbol leaves no room for upright type text")
+
+        type_width=left-SET_SYMBOL_TYPE_GAP-tx
+        if type_width<=0:
+            raise BuildError("Flip set symbol leaves no room for upright type text")
+        primary_type["width"]=type_width
+
+        type_center=ty+(th/2.0)
+        symbol_y=type_center-(symbol_h/2.0)
+        data["setSymbolX"]=left
+        data["setSymbolY"]=symbol_y
+
+        if isinstance(bounds,dict):
+            bounds["x"]=symbol_right
+            bounds["y"]=type_center
+            bounds["horizontal"]="right"
+            bounds["vertical"]="center"
+
+        # Rotated 180-degree text extends physically left from its stored x.
+        # Shrinking width while keeping x fixed therefore moves the visible
+        # left edge rightward, away from the lower P/T medallion.
+        if isinstance(bottom_type,dict) and isinstance(bottom_pt,dict):
+            try:
+                btx=float(bottom_type.get("x"))
+                bpt_right=float(bottom_pt.get("x"))
+            except (TypeError,ValueError):
+                raise BuildError("Flip layout has invalid lower type/P/T geometry")
+            lower_left=bpt_right+SET_SYMBOL_TYPE_GAP
+            lower_width=btx-lower_left
+            if lower_width<=0:
+                raise BuildError("Flip lower P/T box leaves no room for type text")
+            bottom_type["width"]=lower_width
+
+        return {
+            "right":symbol_right,
+            "left":left,
+            "top":symbol_y,
+            "rendered_width":symbol_w,
+            "rendered_height":symbol_h,
+            "centered_on_type":True,
+            "flip_special":True,
+        }
+
+    # Ordinary templates: universal right edge and, when possible, center the
+    # symbol vertically on the primary unrotated type text box.
+    left=SET_SYMBOL_RIGHT_EDGE-symbol_w
+    if left<0:
+        raise BuildError("set symbol is too wide for the universal right-edge anchor")
+    data["setSymbolX"]=left
+
+    if isinstance(bounds,dict):
+        bounds["x"]=SET_SYMBOL_RIGHT_EDGE
+        bounds["horizontal"]="right"
+
