diff --git a/site/styles.css b/site/styles.css
--- a/site/styles.css
+++ b/site/styles.css
@@ -20,0 +21,4 @@
+
+/* Back designer: the guide is a preview overlay, never part of the PNG. */
+.back-mode-choices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:14px 0 20px}.back-mode{border:1px solid var(--line);background:#13171c;color:var(--text);border-radius:9px;padding:12px 9px;text-align:left;white-space:normal}.back-mode b{font-size:12px;display:block}.back-mode small{display:block;font-size:10px;margin-top:5px;line-height:1.5}.back-mode.selected{border-color:var(--accent);background:#33271c}.back-design-preview{display:flex;gap:18px;align-items:flex-start}.back-preview-canvas{flex:0 0 150px;position:relative;line-height:0;max-width:46%}.back-preview-canvas img{display:block;width:100%;height:auto}.back-preview-detail{min-width:0;flex:1;font-size:12px}.back-preview-detail p{color:var(--muted);font-size:11px;margin:8px 0 12px}.back-icon-guide{position:absolute;outline:2px dashed #fff;background:#ffffff16;pointer-events:none}.back-none-preview{aspect-ratio:5/7;display:grid;place-items:center;border:1px dashed var(--line);line-height:1.5;font-size:11px;border-radius:9px}.back-preview-detail .check-line{font-size:10px}.back-preview-detail .check-line small{font-size:9px}#face-back-picker{margin-top:15px}#face-back-picker .back-preview-canvas{flex-basis:110px}.back-preview-detail .button{white-space:normal}.back-mode:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
+@media(max-width:430px){.back-design-preview{gap:12px}.back-preview-canvas{flex-basis:115px}.back-mode{padding:10px 6px}.back-mode b{font-size:11px}.back-mode small{font-size:9px}}
