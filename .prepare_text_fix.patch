def prepare_spell_frame_colors(prepared):
    """Mirror Card Conjurer autoFrame's Prepare-side color detection."""
    mana=str(prepared.get("mana_cost","") or "").upper()
    out=[]
    for ch in mana:
        if ch in "WUBRG" and ch not in out:
            out.append(ch)
    if not out:
        out=["A"]
    return out,("/" in mana)
