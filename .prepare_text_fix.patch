if text.count(old_masks)!=1:
    raise SystemExit(f'expected exactly one PREPARE_MASKS block, found {text.count(old_masks)}')
if text.count(old_build)!=1:
    raise SystemExit(f'expected exactly one old Prepare frame construction block, found {text.count(old_build)}')
text=text.replace(old_masks,new_masks,1)
text=text.replace(old_build,new_build,1)
p.write_text(text,encoding='utf-8')
print('Applied native Prepare layer selection fix.')
